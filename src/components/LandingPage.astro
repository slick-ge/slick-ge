---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Pipeline from '../components/Pipeline.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { email, services, process, toolGroups } from '../data/site';
import { translator, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
---
<BaseLayout locale={locale}>
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span></span>{t("SMALL TEAMS. SMOOTHER SYSTEMS.")}</p>
      <h1 id="hero-title">{t('Less manual work.')}<br /><span class="accent-text">{t('More forward motion.')}</span></h1>
      <p class="hero-description">{t("Your team has better things to build. I help you automate the busywork, simplify infrastructure, and ship with confidence.")}</p>
      <div class="hero-actions"><a class="button button-primary" href={`mailto:${email}`}>{t("Let’s simplify your setup")} <Icon name="arrow" size={19} /></a><a class="text-link" href="#services">{t("Explore services")} <span aria-hidden="true">↓</span></a></div>
      <p class="hero-note"><span class="small-avatar"><img src={`${import.meta.env.BASE_URL}aleksandre-ghvineria.jpeg`} alt="" width="30" height="30" /></span> {t("Aleksandre Ghvineria")} <span class="note-divider">/</span> {t("Independent DevOps consultant")}</p>
    </div>
    <Pipeline locale={locale} />
  </section>
  <div class="container"><div class="specialties well"><span>{t("LESS FRICTION, FROM END TO END")}</span><p>{t("Automation")} <i>·</i> {t("CI/CD")} <i>·</i> {t("Security")} <i>·</i> {t("Infrastructure")}</p></div></div>
  <section class="container section" id="services" aria-label={t("Services")}>
    <SectionHeading eyebrow={t("WHAT I CAN HELP WITH")} title={t("Good systems give you room to build.")} description={t("Practical engineering support for the things that slow your team down. From a single workflow to the infrastructure behind it.")} />
    <div class="services-grid">{services.map(service => <article class="service-card surface"><div class="card-top"><span class="icon-well"><Icon name={service.icon} size={27} /></span><span class="card-number">/{service.number}</span></div><p class="service-label">{t(service.label)}</p><h3>{t(service.title)}</h3><p>{t(service.description)}</p><ul class="service-tags">{service.tags.map(tag => <li>{t(tag)}</li>)}</ul></article>)}</div>
  </section>
  <section class="container section approach" id="approach" aria-label={t("How I work")}>
    <SectionHeading eyebrow={t("HOW WE GET THERE")} title={t("Clear steps. Shared understanding.")} description={t("You work directly with me, from the first conversation to the final handover.")} />
    <ol class="process-grid">{process.map((step, index) => <li><span class="step-number surface-small">0{index + 1}</span><h3>{t(step.title)}</h3><p>{t(step.text)}</p></li>)}</ol>
  </section>
  <section class="container section" id="tools" aria-label={t("Tools and technologies")}>
    <div class="tools-intro"><SectionHeading eyebrow={t("THE TOOLKIT")} title={t("Your stack. A practical approach.")} description={t("Cloud, on-prem, or somewhere in between. I work with the tools that fit your team and the systems you already have.")} /><span class="tool-decoration well" aria-hidden="true"><Icon name="terminal" size={42} /></span></div>
    <div class="tool-groups">{toolGroups.map((group, index) => <details class="tool-group surface-small" open={index === 0}><summary><span class="tool-index">0{index + 1}</span><h3>{t(group.title)}</h3><span class="expand-icon" aria-hidden="true">+</span></summary><ul>{group.tools.map(tool => <li class="well">{tool}</li>)}</ul></details>)}</div>
  </section>
  <section class="container section" id="about" aria-label={t("About me")}>
    <div class="about-card surface"><div class="about-mark surface"><img src={`${import.meta.env.BASE_URL}aleksandre-ghvineria.jpeg`} alt={t("Aleksandre Ghvineria")} width="400" height="400" loading="lazy" /></div><div><p class="eyebrow"><span></span>{t("ONE PERSON. PERSONALLY INVESTED.")}</p><h2>{t("Hi, I’m Aleksandre.")}</h2><p class="about-lead">{t("An independent DevOps and automation consultant, and the person behind Slick.")}</p><p>{t("I help small software teams make their day-to-day engineering work simpler. That might mean untangling a deployment pipeline, bringing infrastructure into code, or connecting tools so a repetitive task takes care of itself.")}</p><p>{t("My approach is practical: understand the problem, choose the right tools, and leave your team with something they can confidently own.")}</p><span class="signature">{t("Aleksandre Ghvineria")}</span></div></div>
  </section>
  <section class="container contact-section" id="contact" aria-labelledby="contact-title"><div class="contact-card surface"><span class="icon-well"><Icon name="mail" size={29} /></span><p class="eyebrow">{t("LET’S MAKE THINGS SIMPLER")}</p><h2 id="contact-title">{t("What’s slowing your team down?")}</h2><p>{t("A stubborn pipeline? Too many manual steps? A setup that’s getting hard to manage? Tell me what you’re working with.")}</p><a class="button button-primary" href={`mailto:${email}`}>{t("Let’s talk about it")} <Icon name="diagonal" size={20} /></a><a class="email-link" href={`mailto:${email}`}>{email}</a></div></section>
</BaseLayout>
