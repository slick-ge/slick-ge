---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutCard from './AboutCard.astro';
import Icon from '../components/Icon.astro';
import ToolLogo from './ToolLogo.astro';
import Pipeline from '../components/Pipeline.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { email, services, process, toolGroups, recentWork } from '../data/site';
import { sitePath } from '../lib/urls';
import { translator, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
---
<BaseLayout locale={locale} pageKind="home">
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span></span>{t("hero.eyebrow")}</p>
      <h1 id="hero-title">{t('hero.title')}<br /> <span class="accent-text">{t('hero.subtitle')}</span></h1>
      <p class="hero-description">{t("hero.description")}</p>
      <p class="hero-coverage">{t("hero.coverage")}</p>
      <p class="hero-credibility">{t("hero.proof")}</p>
      <div class="hero-actions"><a class="button button-primary" href={`mailto:${email}`}>{t("hero.cta")} <Icon name="arrow" size={19} /></a><a class="text-link" href="#services">{t("hero.services")} <span aria-hidden="true">↓</span></a></div>
      <p class="hero-note"><span class="small-avatar"><img src={`${import.meta.env.BASE_URL}aleksandre-ghvineria.jpeg`} alt="" width="30" height="30" /></span> {t("profile.name")} <span class="note-divider">/</span> {t("profile.role")}</p>
    </div>
    <Pipeline locale={locale} />
  </section>
  <div class="container"><div class="specialties well"><span>{t("specialties.title")}</span><p>{t("specialties.automation")} <i>·</i> {t("specialties.delivery")} <i>·</i> {t("specialties.security")} <i>·</i> {t("specialties.infrastructure")}</p></div></div>
  <section class="container section" id="services" aria-label={t("nav.services")}>
    <SectionHeading eyebrow={t("services.eyebrow")} title={t("services.title")} description={t("services.description")} />
    <div class="services-grid">{services.map(service => <article class="service-card surface"><div class="card-top"><span class="icon-well"><Icon name={service.icon} size={27} /></span><span class="card-number">/{service.number}</span></div><h3>{t(service.label)}</h3><p class="service-outcome">{t(service.title)}</p><p>{t(service.description)}</p><p class="service-proof">{t(service.proof)}</p><ul class="service-tags">{service.tags.map(tag => <li>{t(tag)}</li>)}</ul><a class="text-link service-detail-link" href={sitePath(`en/services/${service.slug}/`)}>{t(service.link)} <Icon name="arrow" size={16} /></a></article>)}</div>
  </section>
  <section class="container section" id="engagements" aria-labelledby="engagement-title">
    <div class="section-heading"><p class="eyebrow">{t('engagement.eyebrow')}</p><h2 id="engagement-title">{t('engagement.title')}</h2><p class="section-description">{t('engagement.description')}</p></div>
    <div class="services-grid">
      <article class="service-card surface-small"><h3>{t('engagement.project.title')}</h3><p>{t('engagement.project.description')}</p></article>
      <article class="service-card surface-small"><h3>{t('engagement.support.title')}</h3><p>{t('engagement.support.description')}</p></article>
    </div>
  </section>
  <section class="container section approach" id="approach" aria-label={t("approach.label")}>
    <SectionHeading eyebrow={t("approach.eyebrow")} title={t("approach.title")} description={t("approach.description")} />
    <ol class="process-grid">{process.map((step, index) => <li><span class="step-number surface-small">0{index + 1}</span><h3>{t(step.title)}</h3><p>{t(step.text)}</p></li>)}</ol>
  </section>
  <section class="container section recent-work" id="recent-work" aria-label={t("work.title")}>
    <SectionHeading eyebrow={t("work.eyebrow")} title={t("work.title")} description={t("work.description")} />
    <div class="recent-work-grid">{recentWork.map(item => <article class="recent-work-item surface-small"><p class="service-label">{t(item.role)}</p><h3>{item.org} <span>· {item.period}</span></h3><p>{t(item.detail)}</p></article>)}</div>
  </section>
  <AboutCard locale={locale} />
  <section class="container section" id="tools" aria-label={t("toolkit.label")}>
    <div class="tools-intro"><SectionHeading eyebrow={t("toolkit.eyebrow")} title={t("toolkit.title")} description={t("toolkit.description")} /><span class="tool-decoration well" aria-hidden="true"><Icon name="terminal" size={42} /></span></div>
    <div class="tool-groups">{toolGroups.map((group, index) => <details class="tool-group surface-small" ><summary><span class="tool-index">0{index + 1}</span><h3>{t(group.title)}</h3><span class="expand-icon" aria-hidden="true">+</span></summary><ul>{group.tools.map(tool => { const item = typeof tool === 'string' ? { name: tool, tier: 'familiar' } : tool; return <li class="well"><span class="tool-name"><ToolLogo name={item.name} /><span>{item.name}</span></span><small>{t(item.tier === 'daily' ? 'toolkit.daily' : 'toolkit.familiar')}</small></li>; })}</ul></details>)}</div>
  </section>

  <section class="container contact-section" id="contact" aria-labelledby="contact-title"><div class="contact-card surface"><span class="icon-well"><Icon name="mail" size={29} /></span><p class="eyebrow">{t("contact.eyebrow")}</p><h2 id="contact-title">{t("contact.title")}</h2><p>{t("contact.description")}</p><p class="contact-proof">{t("contact.proof")}</p><a class="button button-primary" href={`mailto:${email}`}>{t("contact.cta")} <Icon name="diagonal" size={20} /></a><a class="email-link" href={`mailto:${email}`}>{email}</a></div></section>
</BaseLayout>
