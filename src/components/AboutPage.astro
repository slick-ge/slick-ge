---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import ToolLogo from './ToolLogo.astro';
import { profile, cvUrl, toolGroups } from '../data/profile';
import { pageBreadcrumb } from '../lib/seo';
import { sitePath } from '../lib/urls';
import { translator, type Locale } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
const data = profile[locale];
const base = import.meta.env.BASE_URL;
---
<BaseLayout locale={locale} title="Aleksandre Ghvineria, DevOps Consultant | Slick" description="Meet Aleksandre Ghvineria, the independent DevOps consultant behind Slick. Explore his production experience, technical background, and selected projects." pageKind="about" breadcrumbs={pageBreadcrumb('About Aleksandre', 'about/')}>
  <section class="container profile-hero" aria-labelledby="profile-title">
    <div class="profile-portrait surface"><img src={`${base}aleksandre-ghvineria.jpeg`} alt={data.name} width="400" height="400" /></div>
    <div class="profile-hero-copy">
      <p class="eyebrow"><span></span>{t('about.eyebrow')}</p>
      <h1 id="profile-title">{data.name}</h1>
      <p class="profile-role">{data.role}</p>
      <p class="profile-summary">{data.summary}</p>
      <div class="profile-actions"><a class="button button-primary" href={`mailto:${data.email}`}>Discuss a project or ongoing support <Icon name="arrow" size={18} /></a><a class="text-link" href={cvUrl} target="_blank" rel="noopener">Download CV (PDF) <Icon name="diagonal" size={18} /></a></div>
    </div>
    <aside class="profile-contact surface-small" aria-label="Contact information"><a class="profile-contact-link" href={`mailto:${data.email}`}><Icon name="mail" />{data.email}</a><a class="profile-contact-link" href={`tel:${data.phone.replaceAll(' ', '')}`}><Icon name="phone" />{data.phone}</a><div class="profile-socials"><a href="https://github.com/ghvinerias" rel="me" aria-label="GitHub"><Icon name="github" size={19} /><span>GitHub</span></a><a href="https://linkedin.com/in/aleksandre-ghvineria" rel="me" aria-label="LinkedIn"><Icon name="linkedin" size={19} /><span>LinkedIn</span></a><a href="https://cs.lpi.org/caf/Xamman/certification/verify/LPI000523471/5lhcz7x9r5" rel="me" aria-label="LPI certification verification — Linux Professional Institute"><Icon name="lpi" size={19} /><span>LPI</span></a></div></aside>
  </section>
  <section class="container profile-section profile-about surface" aria-labelledby="profile-about-title"><p class="eyebrow">A PRACTICAL BACKGROUND</p><h2 id="profile-about-title">My background in production systems.</h2><p>{data.intro}</p><p>I work remotely with international software teams on scoped projects and ongoing engineering support.</p><div class="profile-service-links"><a class="text-link" href={sitePath('services/ci-cd/')}>CI/CD consulting <Icon name="arrow" size={16} /></a><a class="text-link" href={sitePath('services/code-secrets-security/')}>Code and secrets security <Icon name="arrow" size={16} /></a><a class="text-link" href={sitePath('services/cloud-infrastructure/')}>Cloud and infrastructure <Icon name="arrow" size={16} /></a></div></section>
  <section class="container profile-section" aria-labelledby="profile-education-title"><div class="section-heading"><p class="eyebrow">EDUCATION & CERTIFICATIONS</p><h2 id="profile-education-title">Education and certifications.</h2></div><div class="profile-card-grid">{data.certifications.map(item => <article class="profile-info-card surface-small"><h3>{item[0]}</h3><p>{item[1]}</p><time>{item[2]}</time></article>)}</div></section>
  <section class="container profile-section" aria-labelledby="profile-projects-title"><div class="section-heading"><p class="eyebrow">SELECTED WORK</p><h2 id="profile-projects-title">Selected personal projects.</h2></div><div class="profile-card-grid">{data.projects.map(item => <article class="profile-info-card surface-small"><h3>{item[0]}</h3><p>{item[1]}</p>{item[2] ? <a class="text-link" href={item[2]} target="_blank" rel="noopener">View {item[0]} on GitHub <Icon name="diagonal" size={16} /></a> : <p class="project-note">Private repository</p>}</article>)}</div></section>
  <section class="container profile-section" aria-labelledby="profile-toolkit-title"><div class="section-heading"><p class="eyebrow">{t('toolkit.eyebrow')}</p><h2 id="profile-toolkit-title">Tools I work with</h2></div><div class="profile-tool-groups">{toolGroups.map(group => <article class="profile-tool-group surface-small"><h3>{t(group.title)}</h3><div>{group.tools.map(tool => { const item = typeof tool === 'string' ? { name: tool } : tool; return <span class="tool-logo well" title={item.name} aria-label={item.name}><ToolLogo name={item.name} /><b>{item.name}</b></span>; })}</div></article>)}</div></section>
</BaseLayout>
