---
import { toolLogo } from '../data/profile';

interface Props { name: string; }
const { name } = Astro.props;
---
<img class="tool-image" src={toolLogo(name)} alt="" loading="lazy" width="23" height="23" />

<style>
  .tool-image { width: 23px; height: 23px; flex-shrink: 0; object-fit: contain; }
</style>
