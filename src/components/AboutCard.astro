---
import Icon from './Icon.astro';
import { email } from '../data/site';
import { localePath, translator, type Locale } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
---
<section class="container section" id="about" aria-labelledby="about-card-title">
  <div class="about-card surface">
    <div class="about-card-portrait well">
      <img src={`${import.meta.env.BASE_URL}aleksandre-ghvineria.jpeg`} alt={t('profile.name')} width="400" height="400" loading="lazy" />
    </div>
    <div class="about-card-copy">
      <p class="eyebrow"><span></span>{t('about.eyebrow')}</p>
      <h2 id="about-card-title">{t('profile.name')}</h2>
      <p class="about-card-role">{t('profile.role')}</p>
      <p class="about-card-punchline">{t('about.card.punchline')}</p>
      <div class="about-card-actions">
        <a class="button button-primary" href={`mailto:${email}`}>{t('about.card.connect')} <Icon name="arrow" size={18} /></a>
        <a class="text-link" href={`${localePath(locale)}about/`}>{t('about.card.profile')} <Icon name="diagonal" size={18} /></a>
      </div>
      <div class="about-card-contact">
        <a href={`mailto:${email}`}><Icon name="mail" size={17} /><span>{email}</span></a>
        <a href="https://linkedin.com/in/aleksandre-ghvineria" rel="me"><Icon name="linkedin" size={17} /><span>LinkedIn</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-card { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 40px; align-items: center; padding: 40px; }
  .about-card-portrait { width: 160px; aspect-ratio: 1; padding: 10px; border-radius: 50%; }
  .about-card-portrait img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .about-card h2 { margin-top: 14px; font-size: clamp(1.8rem, 3vw, 2.4rem); }
  .about-card-role { margin-top: 8px; color: var(--accent-strong); font-size: .85rem; font-weight: 700; }
  .about-card-punchline { max-width: 580px; margin-top: 16px; color: var(--muted); font-size: .95rem; }
  .about-card-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 24px; }
  .about-card-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 24px; margin-top: 14px; }
  .about-card-contact a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; min-width: 0; color: var(--muted); font-size: .75rem; }
  .about-card-contact span { overflow-wrap: anywhere; }
  .about-card-contact a:hover { color: var(--accent-strong); }
  @media (max-width: 767px) {
    .about-card { grid-template-columns: 1fr; gap: 24px; padding: 30px; }
    .about-card-portrait { width: 120px; }
  }
</style>
