---
import Icon from './Icon.astro';
---
<div class="pipeline-visual" role="img" aria-label="An illustrative delivery pipeline: commit, check, build, deploy, and observe.">
  <div class="orbital-ring ring-outer"></div>
  <div class="orbital-ring ring-inner"></div>
  <div class="pipeline-core surface"><div class="core-well"><Icon name="workflow" size={48} /></div><strong>Less friction.</strong><span>More flow.</span></div>
  <div class="pipeline-node node-commit surface-small"><span class="node-icon"><Icon name="code" size={19} /></span><div><small>01 / SOURCE</small><strong>Commit</strong></div><span class="node-dot"></span></div>
  <div class="pipeline-node node-check surface-small"><span class="node-icon"><Icon name="shield" size={19} /></span><div><small>02 / VALIDATE</small><strong>Check</strong></div><span class="node-dot"></span></div>
  <div class="pipeline-node node-build surface-small"><span class="node-icon"><Icon name="layers" size={19} /></span><div><small>03 / PACKAGE</small><strong>Build</strong></div><span class="node-dot"></span></div>
  <div class="pipeline-node node-deploy surface-small"><span class="node-icon"><Icon name="diagonal" size={19} /></span><div><small>04 / RELEASE</small><strong>Deploy</strong></div><span class="node-dot"></span></div>
  <div class="pipeline-caption"><span></span>DESIGNED TO WORK TOGETHER <span class="observe-label">/ 05 OBSERVE</span></div>
</div>
