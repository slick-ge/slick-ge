---
import Icon from '../components/Icon.astro';
import Fonts from '../components/Fonts.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { translator, localePath, type Locale } from '../i18n';
interface Props { locale?: Locale; title?: string; description?: string; alternates?: boolean; }
const { locale = 'en', alternates = true } = Astro.props;
const t = translator(locale);
const { title = t('meta.title'), description = t('meta.description') } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <Fonts locale={locale} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#E0E5EC" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && <>
      <link rel="alternate" hreflang="en" href={new URL(localePath('en'), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(localePath('en'), Astro.site)} />
    </>}
    <meta property="og:locale" content="en_US" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link button" href="#main">{t("nav.skip")}</a>
    <Header locale={locale} />
    <main id="main"><slot /></main>
    <footer class="container site-footer"><a class="wordmark" href={localePath('en')} aria-label={t("nav.home")}>slick<span>.</span></a><p>{t("footer.tagline")}</p><nav class="footer-links" aria-label={t("footer.social")}><span>{t("footer.social")}</span><a href="https://github.com/ghvinerias" rel="me"><Icon name="github" size={16} />GitHub</a><a href="https://linkedin.com/in/aleksandre-ghvineria" rel="me"><Icon name="linkedin" size={16} />LinkedIn</a><a href="https://cv.ghvineria.com">{t("footer.cv")}</a></nav><span>© {new Date().getFullYear()} Slick</span></footer>
  </body>
</html>
