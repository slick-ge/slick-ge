---
import BaseLayout from '../layouts/BaseLayout.astro';
import { translator, localePath } from '../i18n';
const t = translator('ka');
---
<BaseLayout locale="ka" title={t('Page not found - Slick')} alternates={false}><section class="container error-page"><p class="eyebrow">{t('404 / A SMALL DETOUR')}</p><h1>{t('This path ends here.')}</h1><p>{t('Let’s get you back to something useful.')}</p><a class="button button-primary" href={localePath('ka')}>{t('Back to Slick')}</a><p lang="en">Page not found. <a class="text-link" href={localePath('en')}>Back to Slick in English →</a></p></section></BaseLayout>
