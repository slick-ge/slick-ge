---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { servicePages, type ServicePage } from '../../data/services';
import { email } from '../../data/site';
import { pageBreadcrumb, guidePath } from '../../lib/seo';
import { sitePath } from '../../lib/urls';
import '../../styles/editorial.css';

export function getStaticPaths() {
  return servicePages.map(service => ({ params: { slug: service.slug }, props: { service } }));
}
interface Props { service: ServicePage; }
const { service } = Astro.props;
const path = `services/${service.slug}/`;
const related = servicePages.filter(item => service.related.includes(item.slug));
const contact = `mailto:${email}?subject=${encodeURIComponent(`Discuss ${service.name.toLowerCase()}`)}`;
---
<BaseLayout title={service.title} description={service.description} pageKind="service" service={service} breadcrumbs={pageBreadcrumb(service.name, path)}>
  <article class="container editorial">
    <header class="editorial-hero">
      <p class="eyebrow">INDEPENDENT DEVOPS CONSULTING</p>
      <h1>{service.heading}</h1>
      <p class="editorial-lead">{service.intro}</p>
      <p class="editorial-coverage">Remote collaboration with international software teams.</p>
      <a class="button button-primary" href={contact}>Discuss {service.name.toLowerCase()} <Icon name="arrow" size={18} /></a>
    </header>
    <div class="editorial-layout">
      <div class="editorial-body">
        <section id="project-fit" class="editorial-section surface-small" aria-labelledby="fit-title">
          <h2 id="fit-title">Is this the help your team needs?</h2>
          <p>{service.fit}</p>
        </section>
        {service.sections.map(section => <section id={section.id} class="editorial-section" aria-labelledby={`${section.id}-title`}>
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          {section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
          {section.items && <div class="editorial-cards">{section.items.map(item => <div class="surface-small editorial-card"><h3>{item.title}</h3><p>{item.text}</p></div>)}</div>}
          {section.bullets && <ul class="editorial-list">{section.bullets.map(item => <li>{item}</li>)}</ul>}
        </section>)}
        <section id="experience" class="editorial-section surface-small" aria-labelledby="experience-title">
          <p class="eyebrow">RELEVANT BACKGROUND</p>
          <h2 id="experience-title">Experience behind the work</h2>
          <p>{service.experience}</p>
          <p class="editorial-caption">{service.experienceContext}</p>
          <a class="text-link" href={sitePath('about/')}>About Aleksandre Ghvineria <Icon name="arrow" size={18} /></a>
        </section>
        {service.slug === 'ci-cd' && <section class="editorial-section" aria-labelledby="guide-title">
          <h2 id="guide-title">Preparing to take over a pipeline?</h2>
          <p>Use a practical checklist to review ownership, release steps, rollback and documentation with the people who will run the system.</p>
          <a class="text-link" href={sitePath(guidePath)}>Read the CI/CD handover checklist <Icon name="arrow" size={18} /></a>
        </section>}
        <section id="contact" class="editorial-section surface" aria-labelledby="contact-title">
          <h2 id="contact-title">Tell me about your setup</h2>
          <p>I work on scoped implementation projects and ongoing engineering support. A description of the problem is a useful starting point.</p>
          <ul class="editorial-list">{service.questions.map(question => <li>{question}</li>)}</ul>
          <a class="button button-primary" href={contact}>Email Aleksandre <Icon name="diagonal" size={18} /></a>
          <a class="email-link" href={`mailto:${email}`}>{email}</a>
        </section>
      </div>
      <aside class="editorial-aside" aria-label="Related services">
        <div class="surface-small">
          <h2>Related services</h2>
          <ul>{related.map(item => <li><a href={sitePath(`services/${item.slug}/`)}>{item.name} <Icon name="arrow" size={16} /></a></li>)}</ul>
          <a class="text-link" href={sitePath('#services')}>All services</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
